    {
      "id": 7,
      "type": "timeseries",
      "title": "Nivel sonoro",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-gemelo"
      },
      "description": "Leq: promedio energético. Lmax: máximo de bloques de 32 ms. Fondo: ruido base estimado.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-gemelo"
          },
          "query": "import \"math\"\nfrom(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio\" and r._field == \"leq_db\" and r.grupo =~ /^${grupo:regex}$/)\n  |> map(fn: (r) => ({r with _value: math.pow(x: 10.0, y: r._value / 10.0)}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: 10.0 * math.log10(x: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\", \"nodo\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-gemelo"
          },
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio\" and r._field == \"lmax_db\" and r.grupo =~ /^${grupo:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"nodo\"])"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-gemelo"
          },
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio\" and r._field == \"base_db\" and r.grupo =~ /^${grupo:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"nodo\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 65
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
