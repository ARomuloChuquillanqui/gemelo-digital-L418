      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-gemelo"
          },
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._field == \"anomalias\" and r._value != \"NINGUNA\" and r.grupo =~ /^${grupo:regex}$/)\n  |> keep(columns: [\"_time\", \"_measurement\", \"nodo\", \"_value\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 200)"
        }
      ],
