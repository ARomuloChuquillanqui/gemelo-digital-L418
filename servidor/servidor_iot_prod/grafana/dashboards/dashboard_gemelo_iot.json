    {
      "id": 1,
      "type": "stat",
      "title": "CO₂ actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-gemelo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-gemelo"
          },
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"co2\" and r._field == \"co2_ppm\" and r.grupo =~ /^${grupo:regex}$/)\n  |> filter(fn: (r) => r._value > 0)\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"nodo\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
